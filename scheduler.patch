+import { parsedArgs } from "@/helper";
+import { resolve } from "path";
+import { Model } from "@/model";
+import { assemble } from "./assembler";
+import type { asm, CryptOpt } from "@/types";
+import { readFileSync } from "fs";
+import { tmpdir } from "os";
+import { FiatBridge } from "./bridge/fiat-bridge";
+
+let args = parsedArgs;
+if (!args.readState) {
+  console.error(`Must pass state file to assemble with --readState`);
+  process.exit(1);
+}
+
+const stateFile: CryptOpt.StateFile = JSON.parse(readFileSync(args.readState).toString());
+args = stateFile.parsedArgs;
+
+if (!parsedArgs.readState) throw new Error("Assemble.ts: must pass --readState!");
+
+const tmpDir = tmpdir();
+const sharedObjectFilename = resolve(
+  tmpDir,
+  `libcheckfunctions-s${args.seed}-b${args.bridge}-p${process.pid}.so`,
+);
+
+const bridge = new FiatBridge();
+const symbolname = bridge.machinecode(sharedObjectFilename, args.method, args.curve);
+const json = bridge.getCryptOptFunction(args.method, args.curve);
+Model.import(parsedArgs.readState, json);
+
+const strip = (code: asm[]) => code.filter((line) => line && !line.startsWith(";") && line !== "\n");
+const { code } = assemble(parsedArgs.resultDir);
+process.stdout.write(
+  strip(["SECTION .text", `\tGLOBAL ${symbolname}`, `${symbolname}:`].concat(code)).join("\n"),
+);
