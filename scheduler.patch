+
+import { describe, expect, it } from "vitest";
+
+import {
+  bornSet,
+  freedSet,
+  getAllSchedulable,
+  isNodeFinalConsumerOf,
+  nodeLookupMap,
+  createDependencyRelation,
+  computeSchedulingCost,
+  reorderPressureMinimizing,
+} from "@/model";
+import type { CryptOpt } from "@/types";
+
+function makeExampleDfg(): CryptOpt.StringOperation[] {
+  const n = (name: string[], operation: string, args: string[], datatype: string = "u64") =>
+    ({
+      datatype,
+      operation,
+      name,
+      arguments: args,
+      decisions: {},
+      decisionsHot: [],
+    }) as unknown as CryptOpt.StringOperation;
+  return [
+    n(["x1"], "=", ["arg1[0]"]),
+    n(["x2"], "=", ["arg1[1]"]),
+    n(["x3"], "*", ["x1", "x2"], "u128"),
+    n(["x5"], "+", ["x3_0", "x3_1"]),
+    n(["x6"], "+", ["x5", "x5"]),
+    n(["x30"], "+", ["arg1[1]", "x6"]),
+    n(["out1[1]"], "=", ["x1"]),
+    n(["out1[0]"], "=", ["x2"]),
+  ];
+}
+
+describe("computeBornCount / computeFreedCount", () => {
+  const nodes = makeExampleDfg();
+  const map = nodeLookupMap(nodes);
+  const consumersOf = createDependencyRelation(nodes, map);
+  const indexOf = (name: string) => nodes.findIndex((node) => node.name[0] === name);
+  const scheduled = new Array<number>();
+  describe("with nothing scheduled yet", () => {
+    it.each([
+      ["x1", 1, 0],
+      ["x2", 1, 0],
+      ["x3", 2, 0],
+      ["x5", 1, 2],
+      ["x6", 1, 1],
+      ["x30", 0, 1],
+      ["out1[1]", 0, 0],
+      ["out1[0]", 0, 0],
+    ] as const)("%s: born=%i, freed=%i", (name, expectedBorn, expectedFreed) => {
+      const idx = indexOf(name);
+      expect(bornSet(nodes[idx], consumersOf).size).toBe(expectedBorn);
+      expect(freedSet(nodes[idx], nodes, map, consumersOf, scheduled).size).toBe(expectedFreed);
+    });
+  });
+});
+
+describe("isNodeFinalConsumerOf", () => {
+  const nodes = makeExampleDfg();
+  const nodeIndexOf = nodeLookupMap(nodes);
+  const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+  const indexOf = (name: string) => nodes.findIndex((node) => node.name[0] === name);
+
+  it("returns false when another (unscheduled) consumer of the arg is still pending", () => {
+    // x1 is consumed by x3 (both limbs) and by out1[1]; with nothing scheduled yet,
+    // out1[1] is still pending, so x3 is not (yet) the final consumer of x1.
+    const x3 = nodes[indexOf("x3")];
+    expect(isNodeFinalConsumerOf(x3, "x1", nodeIndexOf, consumersOf, [])).toBe(false);
+  });
+
+  it("returns true once every other consumer of the arg has been scheduled", () => {
+    // Once out1[1] (the only other consumer of x1) has been scheduled, x3 becomes
+    // the final consumer of x1.
+    const x3 = nodes[indexOf("x3")];
+    const out1_1Idx = indexOf("out1[1]");
+    expect(isNodeFinalConsumerOf(x3, "x1", nodeIndexOf, consumersOf, [out1_1Idx])).toBe(true);
+  });
+
+  it("returns true when the node is the sole consumer of the arg", () => {
+    // x5 is the only consumer of x3_0, so it's trivially the final consumer, regardless
+    // of what's been scheduled.
+    const x5 = nodes[indexOf("x5")];
+    expect(isNodeFinalConsumerOf(x5, "x3_0", nodeIndexOf, consumersOf, [])).toBe(true);
+  });
+
+  it("throws when the given arg has no consumers", () => {
+    // x30 is a dead write: nothing reads it, so it never appears as a key in consumersOf.
+    const x30 = nodes[indexOf("x30")];
+    expect(() => isNodeFinalConsumerOf(x30, "x30", nodeIndexOf, consumersOf, [])).toThrow();
+  });
+
+  it("throws when the node itself cannot be found in nodeIndexOf", () => {
+    const bogusNode = {
+      ...nodes[indexOf("x3")],
+      name: ["does-not-exist"],
+    } as unknown as CryptOpt.StringOperation;
+    expect(() => isNodeFinalConsumerOf(bogusNode, "x1", nodeIndexOf, consumersOf, [])).toThrow();
+  });
+});
+
+describe("getAllSchedulable", () => {
+  const nodes = makeExampleDfg();
+  const nodeIndexOf = nodeLookupMap(nodes);
+  const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+  const indexOf = (name: string) => nodes.findIndex((node) => node.name[0] === name);
+
+  it("only offers up the nodes with no unscheduled dependencies, from the start", () => {
+    // x1 and x2 read directly from arg1, so they're immediately schedulable; everything
+    // else transitively depends on one of them.
+    const toBeScheduled = new Set(nodes.keys());
+    const schedulable = getAllSchedulable(toBeScheduled, nodes, consumersOf).sort();
+    expect(schedulable).toEqual([indexOf("x1"), indexOf("x2")].sort());
+  });
+
+  it("unlocks the direct consumers of a node once it's no longer pending", () => {
+    // Once x1 and x2 are scheduled (i.e., removed from toBeScheduled), x3 (which needs both)
+    // and out1[1]/out1[0] (which each need just one of them) all become schedulable; x5
+    // stays blocked since it still needs x3.
+    const toBeScheduled = new Set(nodes.keys());
+    toBeScheduled.delete(indexOf("x1"));
+    toBeScheduled.delete(indexOf("x2"));
+    const schedulable = getAllSchedulable(toBeScheduled, nodes, consumersOf).sort();
+    expect(schedulable).toEqual([indexOf("x3"), indexOf("out1[1]"), indexOf("out1[0]")].sort());
+  });
+
+  it("only offers up x5 (not x6) when both are still pending, since x6 needs x5", () => {
+    const toBeScheduled = new Set([indexOf("x5"), indexOf("x6")]);
+    expect(getAllSchedulable(toBeScheduled, nodes, consumersOf)).toEqual([indexOf("x5")]);
+  });
+
+  it("returns an empty list when there's nothing left to schedule", () => {
+    expect(getAllSchedulable(new Set(), nodes, consumersOf)).toEqual([]);
+  });
+});
+
+describe("computeSchedulingCost", () => {
+  const nodes = makeExampleDfg();
+  const nodeIndexOf = nodeLookupMap(nodes);
+  const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+  const indexOf = (name: string) => nodes.findIndex((node) => node.name[0] === name);
+
+  it.each([
+    ["x1", 1],
+    ["x2", 1],
+    ["x3", 2],
+    ["x5", -1],
+    ["x6", 0],
+    ["x30", -1],
+  ] as const)("%s: born - freed = %i", (name, expectedCost) => {
+    const idx = indexOf(name);
+    expect(computeSchedulingCost(nodes[idx], nodes, nodeIndexOf, consumersOf, [])).toBe(expectedCost);
+  });
+});
+
+function assertValidTopologicalOrder(
+  order: number[],
+  nodes: ReadonlyArray<CryptOpt.StringOperation>,
+  nodeIndexOf: ReadonlyMap<string, number>,
+) {
+  expect(order.length).toBe(nodes.length);
+  expect(new Set(order).size).toBe(nodes.length);
+
+  const positionOf = new Map(order.map((nodeIdx, position) => [nodeIdx, position]));
+  nodes.forEach((node, nodeIdx) => {
+    node.arguments.forEach((arg) => {
+      const producerIdx = nodeIndexOf.get(arg);
+      if (producerIdx === undefined || producerIdx === nodeIdx) return;
+      expect(positionOf.get(producerIdx)!).toBeLessThan(positionOf.get(nodeIdx)!);
+    });
+  });
+}
+
+describe("reorderPressureMinimizing", () => {
+  it.each([1, 2, 3, 4])("produces a valid topological order at lookaheadFactor: %i", (lookaheadFactor) => {
+    const nodes = makeExampleDfg();
+    const nodeIndexOf = nodeLookupMap(nodes);
+    const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+
+    const order = reorderPressureMinimizing(nodes, nodeIndexOf, consumersOf, { lookaheadFactor });
+    assertValidTopologicalOrder(order, nodes, nodeIndexOf);
+  });
+
+  it("doesn't throw when lookaheadFactor exceeds the number of nodes", () => {
+    const nodes = makeExampleDfg();
+    const nodeIndexOf = nodeLookupMap(nodes);
+    const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+
+    const order = reorderPressureMinimizing(nodes, nodeIndexOf, consumersOf, {
+      lookaheadFactor: nodes.length + 10,
+    });
+    assertValidTopologicalOrder(order, nodes, nodeIndexOf);
+  });
+
+  it("rejects a lookaheadFactor below 1", () => {
+    const nodes = makeExampleDfg();
+    const nodeIndexOf = nodeLookupMap(nodes);
+    const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+
+    expect(() =>
+      reorderPressureMinimizing(nodes, nodeIndexOf, consumersOf, { lookaheadFactor: 0 }),
+    ).toThrow();
+  });
+
+  it("throws when the dependency graph is malformed (nothing schedulable but nodes remain)", () => {
+    const n = (name: string[], operation: string, args: string[], datatype = "u64") =>
+      ({
+        datatype,
+        operation,
+        name,
+        arguments: args,
+        decisions: {},
+        decisionsHot: [],
+      }) as unknown as CryptOpt.StringOperation;
+    const cyclicNodes = [n(["x1"], "+", ["x2", "x2"]), n(["x2"], "+", ["x1", "x1"])];
+    const nodeIndexOf = nodeLookupMap(cyclicNodes);
+    const consumersOf = createDependencyRelation(cyclicNodes, nodeIndexOf);
+    expect(() => reorderPressureMinimizing(cyclicNodes, nodeIndexOf, consumersOf)).toThrow();
+  });
+
+  describe("lookahead changes the chosen order", () => {
+    function makeLookaheadDfg(): CryptOpt.StringOperation[] {
+      const n = (name: string[], operation: string, args: string[], datatype = "u64") =>
+        ({
+          datatype,
+          operation,
+          name,
+          arguments: args,
+          decisions: {},
+          decisionsHot: [],
+        }) as unknown as CryptOpt.StringOperation;
+      return [
+        n(["x11"], "+", ["arg1[2]", "arg1[3]"]),
+        n(["x12"], "+", ["arg1[0]", "arg1[1]"]),
+        n(["x13"], "+", ["x12", "arg1[4]"]),
+        n(["x14"], "+", ["x11", "arg1[5]"]),
+        n(["x15"], "+", ["x14", "x14"]),
+      ];
+    }
+
+    it("picks x11 first at lookaheadFactor: 1", () => {
+      const nodes = makeLookaheadDfg();
+      const nodeIndexOf = nodeLookupMap(nodes);
+      const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+      const indexOf = (name: string) => nodes.findIndex((node) => node.name[0] === name);
+
+      const order = reorderPressureMinimizing(nodes, nodeIndexOf, consumersOf, { lookaheadFactor: 1 });
+      expect(order[0]).toBe(indexOf("x11"));
+    });
+
+    it("picks x12 first at lookaheadFactor: 2, since it leads to a better second step", () => {
+      const nodes = makeLookaheadDfg();
+      const nodeIndexOf = nodeLookupMap(nodes);
+      const consumersOf = createDependencyRelation(nodes, nodeIndexOf);
+      const indexOf = (name: string) => nodes.findIndex((node) => node.name[0] === name);
+
+      const order = reorderPressureMinimizing(nodes, nodeIndexOf, consumersOf, { lookaheadFactor: 2 });
+      expect(order[0]).toBe(indexOf("x12"));
+    });
+  });
+});
