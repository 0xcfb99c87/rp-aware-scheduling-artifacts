+
+export function reorderPressureMinimizing(
+  // All parsed nodes in their "canonical" order (never changes).
+  nodes: ReadonlyArray<CryptOpt.StringOperation>,
+  // Map of varname (e.g., "x1") => indice in `nodes` which produces this value.
+  nodeIndexOf: ReadonlyMap<string, number>,
+  // Map of varname (e.g., "x1") => set of direct varnames (as such nodes) which require x1 as part of their computation.
+  consumersOf: ReadonlyMap<string, ReadonlySet<string>>,
+  options?: {
+    lookaheadFactor?: number;
+  },
+): number[] {
+  // Sanity checks, copied from original random toposorting algo.
+  nodes.forEach(assertStringNames);
+  nodes.forEach(assertStringArguments);
+  // Partial ordering of node indices. Also used as the "scheduled" stack for lookahead simulation below.
+  const order: number[] = [];
+  const numNodes = nodes.length;
+  const toBeScheduled = new Set(nodes.keys());
+
+  const lookaheadFactor = options?.lookaheadFactor ?? 1;
+  if (lookaheadFactor < 1) throw new Error(`invalid lookahead factor: ${lookaheadFactor}`);
+
+  // Memoize results from bestSchedulableCandidate, using partial schedule + depth as key.
+  const cache = new Map<bigint, { nodeIdx: number; totalCost: number }>();
+
+  // Main scheduling loop.
+  while (order.length < numNodes) {
+    const result = bestSchedulableCandidate(
+      toBeScheduled,
+      order,
+      lookaheadFactor,
+      nodes,
+      nodeIndexOf,
+      consumersOf,
+      cache,
+    );
+    if (result === undefined) {
+      throw new Error(`Expected at least one schedulable operation, got 0. Bad dependency graph?`);
+    }
+    order.push(result.nodeIdx);
+    toBeScheduled.delete(result.nodeIdx);
+  }
+
+  return order;
+}
+
+// Returns the net register-pressure cost (born - freed) of scheduling `node` given the
+// partial schedule `scheduled` so far. Pure with respect to its inputs.
+export function computeSchedulingCost(
+  node: CryptOpt.StringOperation,
+  nodes: ReadonlyArray<CryptOpt.StringOperation>,
+  nodeIndexOf: ReadonlyMap<string, number>,
+  consumersOf: ReadonlyMap<string, ReadonlySet<string>>,
+  scheduled: ReadonlyArray<number>,
+): number {
+  const born = bornSet(node, consumersOf).size;
+  const freed = freedSet(node, nodes, nodeIndexOf, consumersOf, scheduled).size;
+  return born - freed;
+}
+
+// Recursively determines which currently schedulable candidate minimizes the total
+// scheduling cost over up to `depth` steps (this candidate's own cost, plus the best
+// achievable cost of the following `depth - 1` steps).
+function bestSchedulableCandidate(
+  toBeScheduled: Set<number>,
+  scheduled: number[],
+  depth: number,
+  nodes: ReadonlyArray<CryptOpt.StringOperation>,
+  nodeIndexOf: ReadonlyMap<string, number>,
+  consumersOf: ReadonlyMap<string, ReadonlySet<string>>,
+  cache: Map<bigint, { nodeIdx: number; totalCost: number }>,
+): { nodeIdx: number; totalCost: number } | undefined {
+  if (toBeScheduled.size === 0) return undefined;
+
+  const cacheKey = computeCacheKey(toBeScheduled, depth);
+  const cached = cache.get(cacheKey);
+  if (cached !== undefined) return cached;
+
+  const schedulable = getAllSchedulable(toBeScheduled, nodes, consumersOf).sort((a, b) => a - b);
+  if (schedulable.length === 0) {
+    throw new Error(`Expected at least one schedulable operation, got 0. Bad dependency graph?`);
+  }
+
+  const immediateCosts = new Map(
+    schedulable.map((candidateIdx) => [
+      candidateIdx,
+      computeSchedulingCost(nodes[candidateIdx], nodes, nodeIndexOf, consumersOf, scheduled),
+    ]),
+  );
+
+  let bestNodeIdx = schedulable[0];
+  let bestTotalCost = Infinity;
+
+  const totalCosts = new Map(schedulable.map((candidateIdx) => [candidateIdx, 1]));
+
+  for (const candidateIdx of schedulable) {
+    const cost = immediateCosts.get(candidateIdx)!;
+
+    scheduled.push(candidateIdx);
+    toBeScheduled.delete(candidateIdx);
+
+    const restCost =
+      depth > 1
+        ? bestSchedulableCandidate(
+            toBeScheduled,
+            scheduled,
+            depth - 1,
+            nodes,
+            nodeIndexOf,
+            consumersOf,
+            cache,
+          )?.totalCost ?? 0
+        : 0;
+
+    scheduled.pop();
+    toBeScheduled.add(candidateIdx);
+
+    const totalCost = cost + restCost;
+    totalCosts.set(candidateIdx, totalCost);
+    if (totalCost < bestTotalCost) {
+      bestTotalCost = totalCost;
+      bestNodeIdx = candidateIdx;
+    }
+  }
+
+  const eligible = Array.from(totalCosts).filter((candidate) => candidate[1] == bestTotalCost);
+  const idx = Paul.chooseBetween(eligible.length);
+  bestNodeIdx = eligible[idx][0];
+  bestTotalCost = eligible[idx][1];
+
+  const result = { nodeIdx: bestNodeIdx, totalCost: bestTotalCost };
+  cache.set(cacheKey, result);
+
+  return result;
+}
+
+
+
+
+// Used for keying memoization hashmap in main scheduling loop.
+function computeCacheKey(toBeScheduled: ReadonlySet<number>, depth: number): bigint {
+  let mask = 0n;
+  for (const nodeIdx of toBeScheduled) {
+    mask |= 1n << BigInt(nodeIdx);
+  }
+  return (mask << 32n) | BigInt(depth);
+}
+
+
+
+
+// Returns a list of schedulable operations, based upon all toBeScheduled operations.
+export function getAllSchedulable(
+  toBeScheduled: Set<number>,
+  nodes: ReadonlyArray<CryptOpt.StringOperation>,
+  consumersOf: ReadonlyMap<string, ReadonlySet<string>>,
+): number[] {
+  const schedulable = [] as number[];
+  for (const possibleCandidate of toBeScheduled) {
+    let canSchedule = true;
+    for (const unscheduledNodes of toBeScheduled) {
+      if (isADependentOnB(possibleCandidate, unscheduledNodes, nodes, consumersOf)) {
+        canSchedule = false;
+        break;
+      }
+    }
+    if (canSchedule) {
+      schedulable.push(possibleCandidate);
+    }
+  }
+  return schedulable;
+}
+
+// Returns a set of variables which are "born" by an operation (i.e., it's outputs, limbified).
+// Accounts for 128-bit operations requiring two virtual registers.
+export function bornSet(
+  node: CryptOpt.StringOperation,
+  consumersOf: ReadonlyMap<string, ReadonlySet<string>>,
+): Set<CryptOpt.Varname> {
+  const limbs = makeU64NameLimbs(node);
+  const born = new Set<CryptOpt.Varname>();
+  // Filter out non-intermediates (e.g., out[1]) and variables which have no consumers
+  // (probably not necessary, given that the only variables of such types are out[n]).
+  limbs.forEach((limb) => {
+    if ((consumersOf.get(limb)?.size ?? 0) > 0 && isXD(limb)) {
+      born.add(limb);
+    }
+  });
+  return born;
+}
+
+export function freedSet(
+  node: CryptOpt.StringOperation,
+  nodes: ReadonlyArray<CryptOpt.StringOperation>,
+  nodeIndexOf: ReadonlyMap<string, number>,
+  consumersOf: ReadonlyMap<string, ReadonlySet<string>>,
+  scheduled: ReadonlyArray<number>,
+): Set<string> {
+  // First, get all intermediate arguments for this node.
+  const vars = new Set<string>();
+  const args = node.arguments.filter(isXD);
+  // Next, determine for each of these args whether all other consumers have already been scheduled.
+  args.forEach((arg) => {
+    // consumersOf is keyed by limb (e.g. "x12_0"/"x12_1"), never by a u128's base name (e.g. "x12"),
+    // so a u128 arg must be expanded into its limbs before it can be looked up.
+    const nodeThatProducesThisArg = nodes[nodeIndexOf.get(arg)!];
+    const argLimbs = nodeThatProducesThisArg.datatype === "u128" ? limbify(arg) : [arg];
+    argLimbs
+      .filter((limb) => consumersOf.has(limb))
+      .forEach((limb) => {
+        // If this node is the last consumer, this implies that we free it. So, add it to the vars list.
+        if (isNodeFinalConsumerOf(node, limb, nodeIndexOf, consumersOf, scheduled)) {
+          vars.add(limb);
+        }
+      });
+  });
+
+  return vars;
+}
+
+export function isNodeFinalConsumerOf(
+  node: CryptOpt.StringOperation,
+  arg: string,
+  nodeIndexOf: ReadonlyMap<string, number>,
+  consumersOf: ReadonlyMap<string, ReadonlySet<string>>,
+  scheduled: ReadonlyArray<number>,
+) {
+  const consumers = consumersOf.get(arg);
+  if (consumers === undefined) throw new Error(`arg ${arg} has no consumers`);
+
+  // node.name[0] may be "_" (i.e., a discarded output such as an unused carry portion)
+  // This is an invalid name in the node lookup map, so in this case just
+  // fall back to any other name the node produces to find its own index.
+  const ownName = node.name.find((n) => nodeIndexOf.has(n));
+  const nodeIdx = ownName === undefined ? undefined : nodeIndexOf.get(ownName);
+  if (nodeIdx === undefined) throw new Error(`node ${node} has no valid index`);
+
+  for (const con of consumers) {
+    const consumerNodeIndex = nodeIndexOf.get(con)!;
+    if (consumerNodeIndex !== nodeIdx && !scheduled.includes(consumerNodeIndex)) {
+      return false;
+    }
+  }
+  return true;
+}
